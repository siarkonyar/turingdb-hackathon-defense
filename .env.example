# Copy to .env (gitignored) and fill in. Read by the API and the agents at start-up;
# real environment variables always win over this file.

# serve the live TuringDB `theatre` graph (agents and the wargame need it); default is mock fixtures
OPSMAP_BACKEND=turingdb

# Featherless AI key for the LLM agents. Without it, live matches cannot start but replay still works.
FEATHERLESS_API_KEY=
