# Copy to .env (gitignored) and fill in. Read by the API and the agents at start-up;
# real environment variables always win over this file.

# serve the live TuringDB `theatre` graph (agents and the wargame need it); default is mock fixtures
OPSMAP_BACKEND=turingdb

# Featherless AI key for the LLM agents. Without it, live matches cannot start but replay still works.
FEATHERLESS_API_KEY=

# Optional hybrid Blue: LLM proposes, Featherless Simple Jev selects, Python measures.
# Production classifiers require Featherless Developer-plan access (currently beta).
BLUE_JEV_ENABLED=0
BLUE_JEV_MODEL=featherless-ai/gemma-4-26B-A4B-classifier
BLUE_JEV_TIMEOUT=15
# Conditional option probability, not calibrated correctness; default accepts valid choices.
BLUE_JEV_MIN_CONFIDENCE=0
BLUE_JEV_PRIORITIES=Protect critical parts and priority programmes; respect the available intervention budget.
