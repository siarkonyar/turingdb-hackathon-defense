{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "opsmap-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "uvicorn",
        "api.main:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "opsmap-api-live",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "export OPSMAP_BACKEND=turingdb; export FEATHERLESS_API_KEY=\"${FEATHERLESS_API_KEY:-$(launchctl getenv FEATHERLESS_API_KEY)}\"; exec uv run uvicorn api.main:app --port 8000"
      ],
      "port": 8000
    },
    {
      "name": "opsmap-ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "ui",
        "run",
        "dev"
      ],
      "port": 5173
    }
  ]
}
